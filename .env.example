# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Allowed company email domains for Google Sign-In (comma-separated)
VITE_ALLOWED_EMAIL_DOMAINS=ima360.com

# Inactivity Timeout (optional, milliseconds — defaults to 5 minutes idle + 60s warning)
# VITE_IDLE_TIMEOUT_MS=300000
# VITE_IDLE_WARNING_MS=60000
